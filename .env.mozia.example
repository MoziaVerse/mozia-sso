# Production-only values for docker-compose.mozia.yml.
# Copy to .env on the server and fill real values there. Never commit .env.

MOZIA_SSO_BIND_LOCAL=127.0.0.1:8778
dataSourceName=host=postgres-dev port=5432 user=mozia_sso password=replace_with_database_password sslmode=disable dbname=mozia_sso_db
redisEndpoint=
radiusSecret=replace_with_radius_secret
